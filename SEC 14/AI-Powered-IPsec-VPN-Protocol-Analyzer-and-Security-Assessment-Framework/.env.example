# Copy this file to `.env` and fill in values for your machine.
# `.env` is git-ignored. Never commit real credentials.

# SQLAlchemy database URL. Leave empty to use the default local SQLite file
# at backend/data/application.db.
DATABASE_URL=

# Address the FastAPI server binds to.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
# A wildcard is rejected when APPLICATION_MODE=PRODUCTION.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One of: DEMO, DEVELOPMENT, PRODUCTION
APPLICATION_MODE=DEMO

# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used for signing JWT session tokens. In production, provide a strong 256-bit secret.
JWT_SECRET_KEY=sih-ipsec-vpn-jwt-secret-key-production-change-me-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Brute-force rate limiting: maximum consecutive failures before temporary lockout
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Set COOKIE_SECURE=true to enforce Secure cookies over HTTPS (auto-enabled in PRODUCTION mode)
COOKIE_SECURE=false

# Optional SMTP configuration for outgoing password reset emails (in DEMO mode, links are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ipsec-analyzer.local
